# 瑞学五子棋 systemd 单元文件（可选）
# HTTPS 只监听 8003。证书由 start.sh --issue-le 通过 443 TLS-ALPN 申请。

[Unit]
Description=RxGobang 瑞学五子棋
After=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/www/wwwroot/RxGobang8003
ExecStart=/bin/bash /www/wwwroot/RxGobang8003/start.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
